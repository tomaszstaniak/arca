From 87ceb7d26b383af64d6fa58433bd8169a0921ec8 Mon Sep 17 00:00:00 2001
From: tomaszstaniak <68373859+tomaszstaniak@users.noreply.github.com>
Date: Sun, 18 Oct 2026 13:53:16 +0200
Subject: [PATCH] xad: LhA: directories, protection bits and names in level 1
 and 2 headers

Four faults in LhAParseExt (level 1 and 2 headers), found by packing an
Amiga tree with LHa for UNIX's Amiga build and with Amiga LhA 2.15 and
reading both back:

1. A "-lhd-" (directory) entry whose base name field holds only the NUL
   before an Amiga comment ("\0comment") was taken for a file: the code
   saw a name. The directory came out as an empty file, and the files
   below it failed. The level 0 parser already checks the method; this
   one now does as well.

2. Extension 0x50 holds a UNIX mode (LHA header specification). With OS
   id 'A' it replaced the Amiga attribute byte and was then converted as
   Amiga protection bits, so a file packed as sp-rw-d came back as
   hs---we-. A 0x50 value is now converted as UNIX permissions whatever
   the OS id; the attribute byte is used as before when there is none.
   0x40 (MS-DOS attributes) keeps its own path.

3. The attribute byte was read through a signed char, so every Amiga
   attribute with the h bit (0x80) became negative and was dropped as
   "no protection": hsparwed came back as ----rwed.

4. Spaces in names were turned into '_' ("space name" extracted as
   "space_name"); the level 0 parser replaces control characters only,
   and this one now does the same.

Reproduce: on AROS One 1.3, "lha a1 RAM:t.lha Amiga" over a drawer with
a commented subdrawer, a file named "space name" and files with h, s, p,
a set; list and extract RAM:t.lha with any XAD client. LHa for UNIX
1.14i and 7-Zip on a host, and Amiga LhA 2.15, list the same archive
with its directories as directories, its names and its protection bits.

Repository: contrib (https://github.com/aros-development-team/contrib.git)
Base: be30bc6ad191303ca8753bd3f15e4c78b1278f57
Requires: 0001-xad-LZX-store-the-pure-bit-as-FIBF_PURE.patch (context only)
Scope: all targets of XAD's LhA client
Tested: AROS One 1.3, ABIv11 x86_64 (2026-10-18), Unarc's static XAD: an archive from LHa for UNIX's Amiga build with h, s, p, a bits, comments on files and a drawer, an empty drawer and names with spaces lists and extracts identically to its source
Upstream-Status: candidate (not submitted)
Removal: when contrib carries an equivalent change and the pin moves past it
---
 workbench/libs/xad/portable/clients/LhA.c | 27 ++++++++++++++++++-----
 1 file changed, 21 insertions(+), 6 deletions(-)

diff --git a/workbench/libs/xad/portable/clients/LhA.c b/workbench/libs/xad/portable/clients/LhA.c
index e99b94de..584b0d47 100644
--- a/workbench/libs/xad/portable/clients/LhA.c
+++ b/workbench/libs/xad/portable/clients/LhA.c
@@ -93,6 +93,7 @@ struct xadMasterBase *xadMasterBase)
   xadINT32 namesize = 0, dirsize = 0, commentsize = 0, groupsize = 0, usersize = 0;
   xadUINT32 userid = 0, groupid = 0;
   xadINT32 time = 0, prot = -1, err = 0;
+  xadINT32 unixprot = 0; /* prot is a UNIX mode (extension 0x50) */
   xadUINT8 buf[128];
   xadSTRPTR buf2 = 0;
   xadUINT8 *bufptr;
@@ -112,7 +113,8 @@ struct xadMasterBase *xadMasterBase)
     if(head[20] >= 2) os = head[23];
   }
 
-  prot = head[19];
+  /* Unsigned: an Amiga attribute with the h bit (0x80) is not "none". */
+  prot = (xadUINT8) head[19];
 
   while(nextsize && !err)
   {
@@ -174,9 +176,12 @@ struct xadMasterBase *xadMasterBase)
         break;
       case 0x40:
         if (os == 0) os = 'M'; // force OS ID for MS-DOS protection bits
-      case 0x50: /* File permission */
         prot = EndGetI16(&bufptr[1]);
         break;
+      case 0x50: /* File permission: a UNIX mode, whatever OS wrote it */
+        prot = EndGetI16(&bufptr[1]);
+        unixprot = 1;
+        break;
       case 0x51: /* ID's */
         groupid = EndGetI16(&bufptr[1]);
         userid = EndGetI16(&bufptr[3]);
@@ -245,7 +250,10 @@ struct xadMasterBase *xadMasterBase)
     TAG_IGNORE, commentsize, XAD_OBJPRIVINFOSIZE, sizeof(struct LhAPrivate)
     + groupsize + usersize, TAG_DONE)))
     {
-      if(prot>=0)
+      if(prot>=0 && unixprot)
+        xadConvertProtection(XADM XAD_PROTUNIX, prot, XAD_GETPROTFILEINFO,
+          fi, TAG_DONE);
+      else if(prot>=0)
       {
         switch(os)
         {
@@ -300,9 +308,13 @@ struct xadMasterBase *xadMasterBase)
         xadCopyMem(XADM comment, fi->xfi_Comment, commentsize-1);
       else if(comment2)
         xadCopyMem(XADM comment2, fi->xfi_Comment, commentsize-1);
-      if(!filename && !filename2)
+      /* A directory: no name at all, or "-lhd-" with an empty name. An
+       * Amiga level 1 header keeps a directory's comment after the name as
+       * "\0comment", which leaves an empty name of length 1. */
+      if(!filename && (!filename2 || (!filename2[0] && head[4] == 'h' && head[5] == 'd')))
       {
-        xadCopyMem(XADM dirname, fi->xfi_FileName, dirsize-1);
+        if(dirname)
+          xadCopyMem(XADM dirname, fi->xfi_FileName, dirsize-1);
         fi->xfi_Flags |= XADFIF_DIRECTORY;
       }
       else
@@ -321,7 +333,8 @@ struct xadMasterBase *xadMasterBase)
       {
         if((xadUINT8)*filename2 == '\\' || (xadUINT8)*filename2 == 0xFF)
           *filename2 = '/';
-        else if((*filename2&0x7F) <= 0x20 || *filename2 == 0x7F)
+        /* Control characters only, as for level 0: a space is a name's own. */
+        else if((*filename2&0x7F) < 0x20 || *filename2 == 0x7F)
           *filename2 = '_';
       }
       fi->xfi_Size = EndGetI32(&head[11]);
@@ -335,6 +348,8 @@ struct xadMasterBase *xadMasterBase)
       xadCopyMem(XADM head+2, LHAPI(fi)->NamePart, 5); /* 0 byte already there! */
       fi->xfi_EntryInfo = (xadSTRPTR) LHAPI(fi)->NamePart;
       LHAPI(fi)->Method = EndGetM32(head+2);
+      if(head[4] == 'h' && head[5] == 'd')
+        fi->xfi_Flags |= XADFIF_DIRECTORY;
       if(!fi->xfi_FileName[0])
       {
         fi->xfi_FileName = xadGetDefaultName(XADM XAD_ARCHIVEINFO, ai, XAD_EXTENSION,
-- 
