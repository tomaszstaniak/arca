# Example only. Copy to local.env (ignored) and set the paths for this machine.
# Environment variables that are already set take precedence over local.env.
# Relative paths resolve from the directory containing local.env.

# Directory holding x86_64-aros-gcc, -ar, -ranlib, -nm for the ABIv11 toolchain.
UNARC_TOOLCHAIN_ABIV11=""
# ABIv11 SDK root: the directory that contains include/ and lib/ (SDK-202609/Development).
UNARC_SDK_ABIV11=""
# Optional: a directory with local clones of the dependency repositories
# (libarchive, xz, contrib). fetch-deps.sh clones from there instead of the network.
UNARC_DEPS_MIRROR=""
